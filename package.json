{
  "name": "digit-lens",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "Browser-first Sudoku board recognition library with OCR capabilities.",
  "author": {
    "name": "Juan Castrillon",
    "email": "jfcastrillonr@gmail.com",
    "url": "https://github.com/jufecara"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jufecara/digit-lens.git"
  },
  "bugs": {
    "url": "https://github.com/jufecara/digit-lens/issues"
  },
  "homepage": "https://github.com/jufecara/digit-lens#readme",
  "keywords": [
    "sudoku",
    "ocr",
    "digit-recognition",
    "computer-vision",
    "browser",
    "typescript"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@digit-lens/core",
    "demo": "npm run demo --workspace=@digit-lens/demo",
    "demo:build": "npm run demo:build --workspace=@digit-lens/demo",
    "test": "npm run test --workspace=@digit-lens/core",
    "test:unit": "npm run test:unit --workspace=@digit-lens/core",
    "typecheck": "npm run typecheck --workspace=@digit-lens/core",
    "coverage": "npm run coverage --workspace=@digit-lens/core",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.4"
  },
  "engines": {
    "node": ">=20"
  }
}
